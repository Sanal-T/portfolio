# Copy this file to .env and fill in real values. Never commit .env itself.

ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# SMTP credentials for the contact form email service
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Where contact-form messages get delivered, and what address they're sent from
CONTACT_RECIPIENT_EMAIL=
CONTACT_SENDER_EMAIL=

# Web3Forms API Key (Free, zero-backend form submissions directly to your inbox)
# Generate a free key in 30 seconds at https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
